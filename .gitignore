dist/
out/
.next/
.nuxt/
.output/
saas/backend/dist/
admin/backend/dist/
saas/frontend/build/*
!saas/frontend/build/.gitkeep
saas/frontend/dist/
admin/frontend/dist/

# TypeScript
*.tsbuildinfo

# Testes e cobertura
coverage/
.nyc_output/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache e temporários
.cache/
.temp/
.tmp/
*.tmp
*.swp
*.swo
*~

# SO
.DS_Store
Thumbs.db

# IDEs / editores
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace

# Prisma (artefatos gerados do seed)
