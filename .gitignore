# Dependências
node_modules/

# Variáveis de ambiente (nunca commitar segredos)
.env
.env.*
!.env.example
!.env.qa.example
saas/backend/.env
saas/frontend/.env
admin/backend/.env
admin/frontend/.env

# Build / artefatos compilados
build/*
