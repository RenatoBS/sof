# ---------- servidor ----------
PORT=3000
# URL pública onde a aplicação roda (usada para montar back_urls/notification_url do Mercado Pago)
PUBLIC_URL=http://localhost:3000
# Em produção, defina como "production": isso liga o cookie de sessão "secure" (exige HTTPS)
# e passa a EXIGIR um JWT_SECRET configurado (o servidor recusa subir sem ele).
NODE_ENV=development

# Segredo usado para assinar o cookie de sessão (JWT). Gere um valor aleatório forte em produção.
# ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte

# ---------- conta de teste ----------
# Criada em silêncio no primeiro start, só pra você logar e testar — não aparece em
# nenhum lugar da interface (nem na tela de login, nem em nenhuma resposta da API).
# Troque o e-mail/senha abaixo antes de divulgar o site publicamente, ou desative de vez
# com SEED_DEMO_ENABLED=false quando não precisar mais dela.
SEED_DEMO_ENABLED=true
SEED_DEMO_EMAIL=demo@soft.com
SEED_DEMO_PASSWORD=troque-esta-senha-antes-de-ir-pra-producao

# ---------- Mercado Pago ----------
# Credenciais da sua conta Mercado Pago (Painel > Suas integrações > Credenciais de produção/teste).
# Sem MP_ACCESS_TOKEN o servidor roda em "modo demonstração": a assinatura é aprovada
# automaticamente sem cobrança real, apenas para você testar o fluxo ponta a ponta.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Chave secreta de assinatura do webhook (Painel > Suas integrações > Webhooks > Assinatura secreta).
MP_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
# Token de acesso do app (System User Token, de preferência permanente).
WHATSAPP_TOKEN=
# ID do número de telefone do WhatsApp Business (Meta for Developers > WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# Valor arbitrário que você escolhe e cadastra também no painel da Meta ao configurar o webhook.
WHATSAPP_VERIFY_TOKEN=troque-este-valor
# App Secret do app da Meta, usado para validar a assinatura (X-Hub-Signature-256) do webhook.
WHATSAPP_APP_SECRET=
