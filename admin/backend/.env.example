# ---------- admin API ----------
PORT=3011
NODE_ENV=development
# Front admin (Expo Web)
PUBLIC_URL=http://localhost:8091
CORS_ORIGIN=http://localhost:8091

# Mesmo Postgres do produto
DATABASE_URL=postgresql://sof:sof@localhost:5433/sof?schema=public
DIRECT_URL=postgresql://sof:sof@localhost:5433/sof?schema=public

# Preferir segredo separado do app de produto
ADMIN_JWT_SECRET=troque-este-valor-admin-por-um-segredo-forte

# Stripe (criar/alterar Products e Prices)
STRIPE_SECRET_KEY=

# Uazapi — ops de instância no admin (mesmo do produto)
WHATSAPP_BASE_URL=
WHATSAPP_ADMIN_TOKEN=
# Legado (instância única), opcional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook da instância aponta para a API produto
API_PUBLIC_URL=http://localhost:3001
