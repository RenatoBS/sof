{
  "name": "sof-solutions",
  "private": true,
  "description": "Sof — monorepo Expo + NestJS",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "saas": "node scripts/dev-stack.js saas",
    "admin": "node scripts/dev-stack.js admin",
    "backend:dev": "npm run start:dev --prefix saas/backend",
    "backend:migrate": "npm run prisma:migrate --prefix saas/backend",
    "backend:seed": "npm run prisma:seed --prefix saas/backend",
    "backend:reset-seed": "npm run prisma:reset-seed --prefix saas/backend",
    "frontend:dev": "npm run start --prefix saas/frontend",
    "frontend:web": "npm run web --prefix saas/frontend",
    "dev:proxy": "node scripts/sof-dev-proxy.js",
    "cloud:bootstrap": "bash scripts/cloud-vm-bootstrap.sh --install",
    "cloud:import-qa-env": "bash scripts/cloud-vm-bootstrap.sh --import-only",
    "admin-backend:dev": "npm run start:dev --prefix admin/backend",
    "admin-frontend:web": "npm run web --prefix admin/frontend",
    "admin:sync-schema": "node -e \"const fs=require('fs');const s=fs.readFileSync('saas/backend/prisma/schema.prisma','utf8').replace(/\\n(?:\\/\\/\\/[^\\n]*\\n)?generator adminClient \\{[\\s\\S]*?\\}\\n/,'\\n');fs.mkdirSync('admin/backend/prisma',{recursive:true});fs.writeFileSync('admin/backend/prisma/schema.prisma',s);console.log('admin/backend/prisma/schema.prisma atualizado');\"",
    "heroku:remotes": "heroku git:remote -a sof-solutions-api -r heroku-api && heroku git:remote -a sof-solutions-web -r heroku-web && heroku git:remote -a sof-solutions-admin-api -r heroku-admin-api && heroku git:remote -a sof-solutions-admin-web -r heroku-admin-web",
    "heroku:remotes:qa": "heroku git:remote -a sof-solutions-api-qa -r heroku-api-qa && heroku git:remote -a sof-solutions-web-qa -r heroku-web-qa",
    "heroku:qa:config": "bash scripts/heroku-set-qa-config.sh",
    "deploy:api": "git push heroku-api HEAD:main",
    "deploy:web": "git push heroku-web HEAD:main",
    "deploy:admin-api": "git push heroku-admin-api HEAD:main",
    "deploy:admin-web": "git push heroku-admin-web HEAD:main",
    "deploy:admin": "bash scripts/deploy-admin.sh",
    "deploy:qa": "bash scripts/deploy-qa.sh",
    "deploy": "npm run deploy:api && npm run deploy:web",
    "deploy:together": "bash scripts/deploy-together.sh",
    "deploy:all": "npm run deploy:api && npm run deploy:web && npm run deploy:admin",
    "release:qa": "bash scripts/release-tag.sh stg",
    "release:prod": "bash scripts/release-tag.sh prod",
    "check:content-sync": "bash scripts/check-content-sync.sh",
    "test:unit:saas-backend": "npm test --prefix saas/backend",
    "test:unit:saas-frontend": "npm test --prefix saas/frontend",
    "test:unit": "npm run test:unit:saas-backend && npm run test:unit:saas-frontend",
    "test:e2e:handoff-api": "node scripts/e2e/handoff-inbox-api.mjs",
    "test:e2e:handoff-browser": "node scripts/e2e/handoff-inbox-browser.mjs",
    "test:e2e:handoff": "npm run test:e2e:handoff-api && npm run test:e2e:handoff-browser",
    "test:e2e:api": "node scripts/e2e/run.mjs --suite=api",
    "test:e2e:browser": "node scripts/e2e/run.mjs --suite=browser",
    "test:e2e:all": "node scripts/e2e/run.mjs --suite=all"
  },
  "engines": {
    "node": "22.x"
  }
}
