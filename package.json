{
  "name": "soft-agendamento",
  "private": true,
  "description": "Soft — monorepo frontend estático + backend NestJS",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "backend:dev": "npm run start:dev --prefix backend",
    "backend:migrate": "npm run prisma:migrate --prefix backend",
    "backend:seed": "npm run prisma:seed --prefix backend",
    "frontend:start": "npm start --prefix frontend"
  }
}
