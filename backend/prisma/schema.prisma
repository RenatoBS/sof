generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                    String   @id @default(cuid())
  businessName          String
  ownerName             String
  email                 String   @unique
  passwordHash          String
  plan                  String
  planPrice             Float
  whatsappPhoneNumberId String   @default("")
  /// Json: 7 dias (0=domingo…6=sábado), cada um `{ open, start, end }` HH:MM
  openingHours          Json     @default("[{\"open\":false,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"}]")
  status                String   @default("active")
  createdAt             DateTime @default(now())

  employees        Employee[]
  services         Service[]
  appointments     Appointment[]
  checkoutSessions CheckoutSession[]
  whatsappSessions WhatsappSession[]
}

model Employee {
  id                 String   @id @default(cuid())
  accountId          String
  name               String
  email              String?  @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  color              String
  createdAt          DateTime @default(now())

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  services     EmployeeService[]

  @@index([accountId])
}

model Service {
  id        String   @id @default(cuid())
  accountId String
  name      String
  duration  Int
  price     Float
  createdAt DateTime @default(now())

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  employees    EmployeeService[]

  @@index([accountId])
}

model EmployeeService {
  employeeId String
  serviceId  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@index([serviceId])
}

model Appointment {
  id          String   @id @default(cuid())
  accountId   String
  employeeId  String
  serviceId   String
  clientName  String
  clientPhone String   @default("")
  date        String
  time        String
  price       Float
  status      String   @default("confirmed")
  source      String   @default("manual")
  createdAt   DateTime @default(now())

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([employeeId])
  @@index([serviceId])
}

model CheckoutSession {
  id           String   @id @default(cuid())
  planName     String
  price        Float
  name         String
  email        String
  status       String   @default("pending")
  preferenceId String?
  accountId    String?
  tempPassword String?
  delivered    Boolean  @default(false)
  createdAt    DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([email])
}

model WhatsappSession {
  id            String   @id @default(cuid())
  accountId     String
  customerPhone String
  step          String   @default("start")
  data          Json     @default("{}")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, customerPhone])
  @@index([accountId])
}
