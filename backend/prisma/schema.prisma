generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                    String   @id @default(cuid())
  businessName          String
  ownerName             String
  email                 String   @unique
  passwordHash          String
  plan                  String
  planPrice             Float
  whatsappPhoneNumberId String   @default("")
  /// Token da instância Uazapi/Whazap (nunca expor na API pública)
  whatsappInstanceToken String   @default("")
  whatsappConnectedAt   DateTime?
  /// Json: 7 dias (0=domingo…6=sábado), cada um `{ open, start, end }` HH:MM
  openingHours          Json     @default("[{\"open\":false,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"},{\"open\":true,\"start\":\"09:00\",\"end\":\"18:00\"}]")
  status                String   @default("active")
  createdAt             DateTime @default(now())

  employees        Employee[]
  services         Service[]
  clients          Client[]
  appointments     Appointment[]
  checkoutSessions CheckoutSession[]
  whatsappSessions WhatsappSession[]
}

model Employee {
  id                 String   @id @default(cuid())
  accountId          String
  name               String
  email              String?  @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  color              String
  createdAt          DateTime @default(now())

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  services     EmployeeService[]

  @@index([accountId])
}

model Service {
  id        String   @id @default(cuid())
  accountId String
  name      String
  duration  Int
  price     Float
  createdAt DateTime @default(now())

  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  employees    EmployeeService[]

  @@index([accountId])
}

model EmployeeService {
  employeeId String
  serviceId  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@index([serviceId])
}

model Client {
  id                  String    @id @default(cuid())
  accountId           String
  name                String
  phone               String
  /// Se true, bot WhatsApp não responde este cliente até reativar
  botPausedPermanent  Boolean   @default(false)
  /// Mute temporário: bot silencioso enquanto > now()
  botPausedUntil      DateTime?
  createdAt           DateTime  @default(now())

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([accountId, phone])
  @@index([accountId])
}

model Appointment {
  id                String   @id @default(cuid())
  accountId         String
  employeeId        String
  /// `service` = atendimento; `block` = evento livre (almoço, médico, etc.)
  kind              String   @default("service")
  /// Título do evento livre (kind=block); vazio em serviços
  title             String   @default("")
  /// Duração em minutos; obrigatório em block; em service usa Service.duration se null
  durationMinutes   Int?
  serviceId         String?
  clientId          String?
  clientName        String   @default("")
  clientPhone       String   @default("")
  date              String
  time              String
  price             Float    @default(0)
  status            String   @default("confirmed")
  source            String   @default("manual")
  /// Liga ocorrências materializadas da mesma série recorrente
  recurrenceGroupId String?
  createdAt         DateTime @default(now())

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([employeeId])
  @@index([serviceId])
  @@index([clientId])
  @@index([recurrenceGroupId])
}

model CheckoutSession {
  id           String   @id @default(cuid())
  planName     String
  price        Float
  name         String
  email        String
  status       String   @default("pending")
  preferenceId String?
  accountId    String?
  passwordHash String?
  delivered    Boolean  @default(false)
  createdAt    DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([email])
}

model WhatsappSession {
  id            String   @id @default(cuid())
  accountId     String
  customerPhone String
  step          String   @default("start")
  data          Json     @default("{}")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, customerPhone])
  @@index([accountId])
}
