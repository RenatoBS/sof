# ---------- servidor ----------
PORT=3001
# URL pública do frontend Expo Web (back_urls do Mercado Pago)
PUBLIC_URL=http://localhost:8081
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:8081,http://localhost:5500
NODE_ENV=development

# PostgreSQL (docker compose no root do projeto — porta host 5433)
DATABASE_URL=postgresql://soft:soft@localhost:5433/soft?schema=public
# URL pública da API (notification_url do Mercado Pago). Em local, deixa em branco
# para usar http://localhost:PORT.
API_PUBLIC_URL=

# Segredo JWT do cookie soft_session
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte

# ---------- conta de teste ----------
SEED_DEMO_ENABLED=true
SEED_DEMO_EMAIL=demo@soft.com
SEED_DEMO_PASSWORD=troque-esta-senha-antes-de-ir-pra-producao

# ---------- Mercado Pago ----------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-este-valor
WHATSAPP_APP_SECRET=
