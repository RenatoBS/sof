# ---------- servidor ----------
PORT=3001
# URL pública do frontend Expo Web (success/cancel do Stripe Checkout)
PUBLIC_URL=http://localhost:8081
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:8081,http://localhost:5500
NODE_ENV=development

# PostgreSQL (docker compose no root — porta host 5433)
DATABASE_URL=postgresql://sof:sof@localhost:5433/sof?schema=public
# Migrations / Prisma (mesmo valor no Docker local; no Supabase use porta 5432)
DIRECT_URL=postgresql://sof:sof@localhost:5433/sof?schema=public
# URL pública da API (webhooks Stripe/WhatsApp). Local: vazio → http://localhost:PORT
API_PUBLIC_URL=

JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte

# ---------- seed (só `prisma db seed` / reset-seed) ----------
SEED_DEMO_ENABLED=true
SEED_DEMO_EMAIL=demo@sof.com
SEED_DEMO_PASSWORD=troque-esta-senha-antes-de-ir-pra-producao

# Admin do painel Sof (mesmo seed; app admin-backend)
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@sof.com
SEED_ADMIN_PASSWORD=troque-esta-senha-antes-de-ir-pra-producao

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- WhatsApp (Uazapi) ----------
# Default no código já é uazapi; pode omitir.
WHATSAPP_PROVIDER=uazapi
WHATSAPP_BASE_URL=
WHATSAPP_ADMIN_TOKEN=
# Opcional: instância única (legado) se não houver admin token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Transcrição de áudio do bot (Uazapi POST /message/download transcribe=true)
OPENAI_API_KEY=

# ---------- WhatsApp Meta Cloud API (só se WHATSAPP_PROVIDER=meta) ----------
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# ---------- E-mail (SMTP — ex. Gmail com senha de app) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Sof <seu@gmail.com>"
