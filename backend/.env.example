# ---------- servidor ----------
PORT=3001
# URL pública do frontend Expo Web (success/cancel do Stripe Checkout)
PUBLIC_URL=http://localhost:8081
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:8081,http://localhost:5500
NODE_ENV=development

# PostgreSQL (docker compose no root do projeto — porta host 5433)
DATABASE_URL=postgresql://sof:sof@localhost:5433/sof?schema=public
# Conexão direta (migrations). Em Docker local, use o mesmo valor de DATABASE_URL.
# Em Supabase, use a connection string na porta 5432 (não o pooler 6543).
DIRECT_URL=postgresql://sof:sof@localhost:5433/sof?schema=public
# URL pública da API (webhooks). Em local, deixa em branco
# para usar http://localhost:PORT — use Stripe CLI: stripe listen --forward-to localhost:3001/api/payments/webhook
API_PUBLIC_URL=

# Segredo JWT do cookie sof_session
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte

# ---------- conta de teste ----------
SEED_DEMO_ENABLED=true
SEED_DEMO_EMAIL=demo@sof.com
SEED_DEMO_PASSWORD=troque-esta-senha-antes-de-ir-pra-producao

# ---------- Stripe ----------
# Preferir restricted key (rk_…) em produção; sk_test_… ok em sandbox.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-este-valor
WHATSAPP_APP_SECRET=
